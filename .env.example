# --- Modes ---
INGEST_MODE=mqtt  # sim | mqtt

# --- MQTT ---
MQTT_HOST=test.mosquitto.org
MQTT_PORT=1883
MQTT_TOPIC=cng/dell-demo/telemetry
MQTT_CLIENT_ID=CNGHealthWatchClient
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=0

# --- Database ---
# Current code uses DB_PATH; DB_URL is for the upcoming adapter (safe to keep here).
DB_URL=sqlite:///./data/sensor_data.db

# --- Locale/paths ---
LOCAL_TZ=Europe/Rome
DATA_DIR=./data
LOG_DIR=./data/logs
EXPORT_DIR=./data/exports
